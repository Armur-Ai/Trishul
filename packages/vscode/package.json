{
  "name": "trishul",
  "displayName": "trishul — Security Scanner for Vibe-Coded Software",
  "description": "Security scanner for AI-generated code — SAST, DAST, exploit simulation, attack path analysis",
  "version": "0.0.1",
  "publisher": "trishul",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Other"],
  "keywords": ["security", "scanner", "SAST", "DAST", "DevSecOps", "vibecoding", "ai-code"],
  "activationEvents": [
    "workspaceContains:.trishul.yml",
    "onCommand:trishul.scanWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "trishul.scanWorkspace",
        "title": "trishul: Scan Workspace"
      },
      {
        "command": "trishul.explainFinding",
        "title": "trishul: Explain Finding"
      },
      {
        "command": "trishul.fixFinding",
        "title": "trishul: Fix with AI"
      }
    ],
    "configuration": {
      "title": "trishul",
      "properties": {
        "trishul.scanDepth": {
          "type": "string",
          "default": "quick",
          "enum": ["quick", "deep"],
          "description": "Default scan depth"
        },
        "trishul.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan on file save"
        },
        "trishul.scanOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Scan workspace when opened"
        },
        "trishul.minSeverity": {
          "type": "string",
          "default": "medium",
          "enum": ["info", "low", "medium", "high", "critical"],
          "description": "Minimum severity to display"
        },
        "trishul.binaryPath": {
          "type": "string",
          "default": "trishul",
          "description": "Path to the trishul binary"
        },
        "trishul.useLocalMode": {
          "type": "boolean",
          "default": true,
          "description": "Run scans locally without a server"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Armur-Ai/Armur-Code-Scanner"
  },
  "license": "MIT"
}
